# ─────────────────────────────────────────────────────────────────────────────
# Sokastar Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Fill in EVERY value below.
# 3. NEVER commit .env to Git. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production


# ── Admin Dashboard ───────────────────────────────────────────────────────────
# The email and password used to log into the admin dashboard.
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your_strong_password_here

# A random 64-character hex string used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_64_char_hex_string


# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key


# ── Safaricom Daraja (M-Pesa) ─────────────────────────────────────────────────
# From https://developer.safaricom.co.ke → Your App
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret

# "sandbox" or "production"
DARAJA_ENV=production

# Your Buy Goods Till Number and Head-Office shortcode
MPESA_SHORTCODE=4053789
MPESA_TILL_NUMBER=6884892

# Optional: comma-separated list of allowed Safaricom callback IPs
# MPESA_IP_WHITELIST=196.201.212.1,196.201.213.1


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://sokastar.co.ke,https://www.sokastar.co.ke
ALLOWED_ORIGINS=https://sokastar.co.ke


# ── Africa's Talking (SMS) ────────────────────────────────────────────────────
SMS_ENABLED=false
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key
# AFRICASTALKING_SENDER_ID=SOKASTAR
# SMS_AUTO_PAYMENT=true
# SMS_PAYMENT_TEMPLATE=Hi {name}! We received KES {amount} for {package}. Receipt: {mpesa}. - Sokastar
